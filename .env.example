# Variables públicas de configuración del cliente (todas deben iniciar con VITE_).
# Nunca coloques secretos privados ni llaves de servicio en variables VITE_*.

# Obligatorio en producción y Cloudflare Pages: URL final sin barra final
# VITE_SITE_URL=https://torneo-del-pavo.pages.dev

# Entorno activo: production | staging
# VITE_APP_ENV=production

# Clave pública de sitio reCAPTCHA Enterprise/v3 para Firebase App Check
# VITE_RECAPTCHA_SITE_KEY=

# Solo para desarrollo/pruebas locales con Firebase Emulator Suite (nunca usar en producción)
# VITE_USE_FIRESTORE_EMULATOR=false

# Configuración pública del proyecto Firebase de pruebas (staging / Vista previa de Cloudflare Pages)
# VITE_FIREBASE_STAGING_PROJECT_ID=
# VITE_FIREBASE_STAGING_API_KEY=
# VITE_FIREBASE_STAGING_AUTH_DOMAIN=
# VITE_FIREBASE_STAGING_APP_ID=
# VITE_FIREBASE_STAGING_MESSAGING_SENDER_ID=
# VITE_FIREBASE_STAGING_DATABASE_ID=(default)
# VITE_FIREBASE_STAGING_RECAPTCHA_SITE_KEY=
