{
  "entities": {
    "Participant": {
      "title": "Participant",
      "description": "Private participant registration document (admin-only read)",
      "type": "object",
      "properties": {
        "nombre": { "type": "string", "minLength": 3, "maxLength": 150 },
        "fechaNacimiento": { "type": "string", "pattern": "^(19[2-9][0-9]|20[0-9]{2})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
        "whatsapp": { "type": "string", "pattern": "^\\d{10}$" },
        "correo": { "type": "string", "maxLength": 100 },
        "categoria": { "type": "string", "enum": ["Juvenil", "Libre"] },
        "estatusPago": { "type": "string", "enum": ["pendiente", "pagado"] },
        "fechaRegistro": { "type": "string", "maxLength": 60 },
        "folio": { "type": "string", "maxLength": 20 },
        "esAficionado": { "type": "boolean" },
        "esFemenil": { "type": "boolean" },
        "tieneRecibo": { "type": "boolean" },
        "reciboId": { "type": "string", "maxLength": 128 },
        "reciboNombreArchivo": { "type": "string", "maxLength": 180 },
        "notas": { "type": "string", "maxLength": 500 },
        "website": { "type": "string" },
        "aceptoAviso": { "type": "boolean" },
        "aceptoAvisoVersion": { "type": "string", "maxLength": 30 },
        "consentimientoTutor": { "type": "boolean" },
        "nombreTutor": { "type": "string", "maxLength": 150 },
        "fechaConsentimiento": { "type": "string", "maxLength": 60 },
        "pagadoPor": { "type": "string", "maxLength": 120 },
        "pagadoEn": { "type": "string", "maxLength": 60 },
        "historial": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "object" }
        },
        "asistencia": { "type": "boolean" },
        "asistenciaEn": { "type": "string", "maxLength": 60 },
        "eliminado": { "type": "boolean" },
        "eliminadoEn": { "type": "string", "maxLength": 60 },
        "eliminadoPor": { "type": "string", "maxLength": 120 }
      },
      "required": [
        "nombre",
        "fechaNacimiento",
        "whatsapp",
        "correo",
        "categoria",
        "estatusPago",
        "fechaRegistro",
        "folio",
        "esAficionado",
        "esFemenil"
      ]
    },
    "PublicParticipant": {
      "title": "PublicParticipant",
      "description": "Sanitized public roster entry (zero contact, birthdate, tutor or receipt data; omits exact age for minors)",
      "type": "object",
      "properties": {
        "folio": { "type": "string", "maxLength": 20 },
        "nombre": { "type": "string", "minLength": 3, "maxLength": 150 },
        "categoria": { "type": "string", "enum": ["Juvenil", "Libre"] },
        "esAficionado": { "type": "boolean" },
        "esFemenil": { "type": "boolean" },
        "estatusPago": { "type": "string", "enum": ["pendiente", "pagado"] },
        "rangoEdad": { "type": "string", "maxLength": 40 },
        "edad": { "type": "number" },
        "fechaRegistro": { "type": "string", "maxLength": 60 }
      },
      "required": ["folio", "nombre", "categoria", "esAficionado", "esFemenil", "estatusPago", "fechaRegistro"]
    },
    "WaitlistEntry": {
      "title": "WaitlistEntry",
      "description": "Waitlist submission when tournament capacity is reached (admin-only read)",
      "type": "object",
      "properties": {
        "nombre": { "type": "string", "minLength": 3, "maxLength": 150 },
        "fechaNacimiento": { "type": "string", "pattern": "^(19[2-9][0-9]|20[0-9]{2})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
        "whatsapp": { "type": "string", "pattern": "^\\d{10}$" },
        "correo": { "type": "string", "maxLength": 100 },
        "categoria": { "type": "string", "enum": ["Juvenil", "Libre"] },
        "esAficionado": { "type": "boolean" },
        "esFemenil": { "type": "boolean" },
        "estatus": { "type": "string", "enum": ["en_espera", "contactado", "convertido"] },
        "fechaRegistro": { "type": "string", "maxLength": 60 },
        "folio": { "type": "string", "maxLength": 20 },
        "aceptoAviso": { "type": "boolean" },
        "aceptoAvisoVersion": { "type": "string", "maxLength": 30 },
        "consentimientoTutor": { "type": "boolean" },
        "nombreTutor": { "type": "string", "maxLength": 150 },
        "fechaConsentimiento": { "type": "string", "maxLength": 60 },
        "notas": { "type": "string", "maxLength": 500 },
        "website": { "type": "string" }
      },
      "required": [
        "nombre",
        "fechaNacimiento",
        "whatsapp",
        "correo",
        "categoria",
        "estatus",
        "fechaRegistro",
        "folio"
      ]
    },
    "RegistrationKey": {
      "title": "RegistrationKey",
      "description": "Deterministic SHA-256 uniqueness lock for email or WhatsApp without exposing PII",
      "type": "object",
      "properties": {
        "tipo": { "type": "string", "enum": ["email", "whatsapp"] },
        "participantId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["tipo", "participantId", "createdAt"]
    },
    "PaymentReceipt": {
      "title": "PaymentReceipt",
      "description": "Admin-only stored payment receipt image/PDF and metadata",
      "type": "object",
      "properties": {
        "participantId": { "type": "string", "maxLength": 128 },
        "folio": { "type": "string", "maxLength": 30 },
        "participantNombre": { "type": "string", "maxLength": 150 },
        "fileName": { "type": "string", "maxLength": 200 },
        "mimeType": { "type": "string", "enum": ["image/jpeg", "image/png", "image/webp", "application/pdf"] },
        "fileSize": { "type": "number" },
        "imageDataUrl": { "type": "string", "maxLength": 950000 },
        "uploadedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["participantId", "folio", "participantNombre", "fileName", "mimeType", "fileSize", "imageDataUrl", "uploadedAt"]
    },
    "TournamentConfig": {
      "title": "TournamentConfig",
      "description": "General settings and editable content of the tournament",
      "type": "object",
      "properties": {
        "titulo": { "type": "string", "maxLength": 150 },
        "edicion": { "type": "string", "maxLength": 80 },
        "slogan": { "type": "string", "maxLength": 200 },
        "club": { "type": "string", "maxLength": 150 },
        "fecha": { "type": "string", "maxLength": 100 },
        "fechaIso": { "type": "string", "maxLength": 50 },
        "hora": { "type": "string", "maxLength": 50 },
        "lugar": { "type": "string", "maxLength": 250 },
        "referencia": { "type": "string", "maxLength": 250 },
        "mapaUrl": { "type": "string", "maxLength": 500 },
        "costo": { "type": "number" },
        "cupoMaximo": { "type": "number" },
        "totalInscritos": { "type": "number" },
        "fechaLimite": { "type": "string", "maxLength": 100 },
        "fechaLimiteIso": { "type": "string", "maxLength": 60 },
        "fechaCorteMayoriaEdad": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "fechaCorteJuvenil": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "habilitarListaEspera": { "type": "boolean" },
        "politicaDevolucionTexto": { "type": "string", "maxLength": 2000 },
        "inscripcionesAbiertas": { "type": "boolean" },
        "clabe": { "type": "string", "maxLength": 30 },
        "banco": { "type": "string", "maxLength": 100 },
        "titular": { "type": "string", "maxLength": 150 },
        "whatsappContacto": { "type": "string", "maxLength": 20 },
        "bolsaPremios": { "type": "string", "maxLength": 150 },
        "primerLugarEfectivo": { "type": "string", "maxLength": 150 },
        "presidente": { "type": "string", "maxLength": 120 },
        "vicepresidente": { "type": "string", "maxLength": 120 },
        "premiacionTexto": { "type": "string", "maxLength": 2000 },
        "sistemaCompetenciaTexto": { "type": "string", "maxLength": 2000 },
        "transitoriosTexto": { "type": "string", "maxLength": 2000 },
        "indicacionesPago": { "type": "string", "maxLength": 1000 }
      },
      "required": ["titulo", "fecha", "costo", "cupoMaximo", "inscripcionesAbiertas"]
    },
    "Sponsor": {
      "title": "Sponsor",
      "description": "Tournament sponsor information",
      "type": "object",
      "properties": {
        "nombre": { "type": "string", "maxLength": 100 },
        "logo": { "type": "string", "maxLength": 950000 },
        "enlace": { "type": "string", "maxLength": 500 },
        "activo": { "type": "boolean" },
        "orden": { "type": "number" },
        "categoriaSponsor": { "type": "string", "maxLength": 120 }
      },
      "required": ["nombre", "logo", "activo"]
    },
    "AdminMember": {
      "title": "AdminMember",
      "description": "Authorized administrator email/UID entry",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 120 },
        "nombre": { "type": "string", "maxLength": 120 },
        "rol": { "type": "string", "maxLength": 80 },
        "agregadoEn": { "type": "string", "maxLength": 60 }
      },
      "required": ["email", "nombre", "rol"]
    }
  },
  "firestore": {
    "/participantes/{participanteId}": {
      "schema": { "$ref": "#/entities/Participant" },
      "description": "Private admin-only registration records"
    },
    "/participantes_publicos/{participanteId}": {
      "schema": { "$ref": "#/entities/PublicParticipant" },
      "description": "Public sanitized roster without PII"
    },
    "/lista_espera/{esperaId}": {
      "schema": { "$ref": "#/entities/WaitlistEntry" },
      "description": "Deterministic SHA-256 email-keyed waitlist submissions when capacity is full (admin-only read)"
    },
    "/registro_llaves/{hashId}": {
      "schema": { "$ref": "#/entities/RegistrationKey" },
      "description": "Write-once SHA-256 duplicate prevention keys"
    },
    "/comprobantes/{comprobanteId}": {
      "schema": { "$ref": "#/entities/PaymentReceipt" },
      "description": "Private admin-only payment receipts vault"
    },
    "/configuracion/{configId}": {
      "schema": { "$ref": "#/entities/TournamentConfig" },
      "description": "Tournament global configuration"
    },
    "/patrocinadores/{patrocinadorId}": {
      "schema": { "$ref": "#/entities/Sponsor" },
      "description": "Sponsors displayed on the landing page"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminMember" },
      "description": "Bootstrap and UID-based admin authorization records"
    },
    "/admins_by_email/{email}": {
      "schema": { "$ref": "#/entities/AdminMember" },
      "description": "Normalized lowercase email-based admin authorization records"
    }
  }
}
